<!-- Управление ALBA -->
<section class="section">
<div class="section-header">
<h2>Управление ALBA</h2>
</div>
<form id="adminGrantAlbaForm"
      method="POST"
      action="/api/p1/alba/grant-by-login"
      class="form-grid"
      novalidate>

  <input type="hidden" name="_csrf" id="albaCsrfField" value="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
  <input type="hidden" name="reason" value="admin_grant">

  <input type="text" id="albaUsername" name="login" placeholder="Логин пользователя" required autocomplete="username">
  <input type="number" id="albaAmount" name="amount" placeholder="Количество ALBA" required min="1" step="1">
  <input type="text" id="albaComment" name="comment" placeholder="Комментарий" required>

  <button type="submit" id="albaSubmitBtn" class="btn primary">
    Начислить ALBA
  </button>
</form>
<div id="albaGrantMsg" class="note" style="margin-top:10px; min-height:1.5em; color:#fff;"></div>
<script src="/js/admin-alba-grant.js?v=1.0.2"></script>

<!-- История транзакций ALBA -->
<div class="section-header" style="margin-top: 30px;">
<h2>История транзакций ALBA</h2>
</div>
<button type="button" id="loadTransactionsBtn" class="btn small" style="margin-bottom: 15px;">Обновить историю</button>
<div id="albaTransactionsContainer">
<% if (typeof albaTransactions !== 'undefined' && albaTransactions && albaTransactions.length) { %>
<div style="overflow-x:auto;">
<table id="albaHistoryTable" style="width:100%;border-collapse:collapse;font-size:0.9rem;">
<thead>
<tr style="text-align:left;border-bottom:1px solid rgba(31,138,90,0.25);">
<th style="padding:8px;">ID</th>
<th style="padding:8px;">Пользователь</th>
<th style="padding:8px;">Тип</th>
<th style="padding:8px;">Причина</th>
<th style="padding:8px;">Сумма</th>
<th style="padding:8px;">Комментарий</th>
<th style="padding:8px;">Дата</th>
</tr>
</thead>
<tbody>
<% albaTransactions.forEach(function(tx) { %>
<tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
<td style="padding:8px;"><%= tx.id %></td>
<td style="padding:8px;"><%= tx.username || '—' %></td>
<td style="padding:8px;"><%= tx.typeLabel || tx.type %></td>
<td style="padding:8px;"><%= tx.reasonLabel || tx.reason %></td>
<td style="padding:8px;"><%= tx.amount %></td>
<td style="padding:8px;"><%= tx.comment || '—' %></td>
<td style="padding:8px;"><%= tx.createdAt ? new Date(tx.createdAt).toLocaleString('ru-RU') : '—' %></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<p class="empty-state">Пока нет записей. Начислите ALBA или нажмите «Обновить историю».</p>
<% } %>
</div>
</section>


<!-- Зарегистрированные пользователи -->
<section class="section">
<div class="section-header">
<h2>Пользователи</h2>
<span class="badge" style="background:#666;color:#fff;padding:4px 12px;border-radius:6px;font-size:0.9rem;">
Всего: <%= typeof registeredUsers !== 'undefined' && registeredUsers ? registeredUsers.length : 0 %>
</span>
</div>
<% if (typeof registeredUsers !== 'undefined' && registeredUsers && registeredUsers.length) { %>
<div style="overflow-x:auto;">
<table style="width:100%;border-collapse:collapse;font-size:0.95rem;">
<thead>
<tr style="text-align:left;border-bottom:1px solid rgba(31,138,90,0.25);">
<th style="padding:8px;">ID</th>
<th style="padding:8px;">Логин</th>
<th style="padding:8px;">Email</th>
<th style="padding:8px;">Тип</th>
<th style="padding:8px;">Роль</th>
<th style="padding:8px;"></th>
</tr>
</thead>
<tbody>
<% registeredUsers.forEach(function (u) {
  const uid = u.id;
  const isSelf = String(uid) === String(typeof currentAdminId !== 'undefined' ? currentAdminId : '');
%>
<tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
<td style="padding:8px;"><%= uid %></td>
<td style="padding:8px;"><%= u.username %></td>
<td style="padding:8px;"><%= u.email %></td>
<td style="padding:8px;"><%= u.accountType === 'services' ? 'Услуги' : 'Реклама' %></td>
<td style="padding:8px;"><%= u.role %></td>
<td style="padding:8px;text-align:right;">
<% if (!isSelf) { %>
<form method="POST" action="/admin/users/<%= uid %>/delete" style="display:inline;" onsubmit="return confirm('Удалить пользователя <%= (u.username || '').replace(/'/g, '') %> из базы? Карточки будут скрыты.');">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
<button type="submit" class="btn small outline">Удалить</button>
</form>
<% } else { %>
<span class="muted">это вы</span>
<% } %>
</td>
</tr>
<% }); %>
</tbody>
</table>
</div>
<% } else { %>
<p class="empty-state">Нет пользователей</p>
<% } %>
</section>


