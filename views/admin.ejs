<body class="admin-page">

  <div id="bg-animated" aria-hidden="true"></div>
<header class="main-header">
<div class="container header-inner">
  <div class="header-top">
    <div class="header-left">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <div class="header-stats">
        <div class="stat-item">
          <span style="opacity: 0.8;">👥</span>
          <strong style="color: #4caf50;"><%= typeof visitorCount !== 'undefined' ? visitorCount : 0 %></strong>
        </div>
        <div class="stat-item">
          <span style="opacity: 0.8;">👤</span>
          <strong style="color: #2196f3;"><%= typeof userCount !== 'undefined' ? userCount : 0 %></strong>
        </div>
      </div>
    <div class="header-actions">
<span class="user-chip">Админ-панель</span>
<a href="/admin/contacts" class="btn outline small" style="margin-left:10px;">Напишите нам</a>
<form id="logoutForm" method="POST" action="/logout" style="display:inline;margin-left:10px;">
<input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
<button type="submit" class="btn outline small">Выход</button>
</form>
</div>
  </div>
</div>
</header>

<script>
(function () {
  var key = 'adminScrollTop';
  var restore = function () {
    try {
      var saved = sessionStorage.getItem(key);
      if (saved === null) return;
      var pos = parseInt(saved, 10);
      var main = document.getElementById('admin-main');
      if (main) main.scrollTop = pos; else window.scrollTo(0, pos);
    } catch (e) {}
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restore);
  } else {
    restore();
  }
  window.addEventListener('beforeunload', function () {
    try {
      sessionStorage.setItem(key, (document.getElementById('admin-main')?.scrollTop || window.scrollY).toString());
    } catch (e) {}
  });
})();
</script>

<main id="admin-main" class="container" style="margin-bottom: 64px;">

<!-- Модерация товаров -->
<section class="section">
<div class="section-header">
<h2>Модерация товаров</h2>
<span class="badge" style="background:#ff9800;color:#fff;padding:4px 12px;border-radius:6px;font-size:0.9rem;">
<% if (pendingProducts && pendingProducts.length) { %>
<%= pendingProducts.length %> на проверке
<% } else { %>
Нет товаров на модерации
<% } %>
</span>
</div>

<% if (pendingProducts && pendingProducts.length) { %>
<div class="product-grid">
<% pendingProducts.forEach(p => { %>
<div class="product-card" style="border:2px solid #ff9800;">
<h3 class="product-title"><%= p.name %></h3>
<%- include('partials/admin-card-images', { item: p }) %>

<div class="product-bottom">
<p class="product-desc"><%= p.description || "—" %></p>
<div class="row" style="justify-content:center; gap:8px;">
<span class="muted">Цена:</span>
<strong class="price"><%= p.price %></strong>
</div>

<% if (p.owner) { %>
<% if (typeof p.owner === 'object' && p.owner.username) { %>
<p class="muted" style="text-align:center;font-size:0.9rem;">От: <%= p.owner.username %></p>
<% } else { %>
<p class="muted" style="text-align:center;font-size:0.9rem;">От: пользователь ID <%= p.owner %></p>
<% } %>
<% } else { %>
<p class="muted" style="text-align:center;font-size:0.9rem;color:#f44336;">⚠️ Владелец не указан</p>
<% } %>

<div class="product-actions" style="flex-direction:column;gap:8px;">
<form method="POST" action="/admin/products/<%= p.id %>/approve">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>">
<button type="submit" class="btn small">Одобрить</button>
</form>
<button type="button" class="btn small reject-btn" data-id="<%= p.id %>" data-type="product">Отклонить</button>
<% if (p.link) { %>
<a class="btn small outline" href="<%= p.link %>" target="_blank" rel="noopener">Ссылка</a>
<% } %>
<% if (p.video_url) { %>
<button type="button" class="btn small outline" data-video="<%= p.video_url %>">Видео</button>
<% } %>
</div>
</div>
</div>
<% }) %>
</div>
<% } else { %>
<p class="empty-state">Нет товаров на модерации</p>
<% } %>
</section>

<!-- Модерация услуг -->
<section class="section">
<div class="section-header">
<h2>Модерация услуг</h2>
<span class="badge" style="background:#ff9800;color:#fff;padding:4px 12px;border-radius:6px;font-size:0.9rem;">
