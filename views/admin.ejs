 <button class="close" data-close-reject aria-label="Закрыть">&times;</button>
 <h3 id="rejectModalTitle">Отклонить карточку</h3>
 <form id="rejectForm">
 <!-- Поля для видео -->
 <div id="videoRejectionFields" style="display:none;">
   <textarea name="rejectionReason" placeholder="Причина отклонения" rows="4" required style="width:100%;padding:8px;border-radius:6px;border:1px solid #444;background:#2b2b2b;color:#fff;resize:vertical;"></textarea>
   <textarea name="adminComment" placeholder="Комментарий администратора (необязательно)" rows="2" style="width:100%;padding:8px;border-radius:6px;border:1px solid #444;background:#2b2b2b;color:#fff;resize:vertical;margin-top:10px;"></textarea>
 </div>
 <!-- Поля для продуктов/услуг/баннеров -->
 <div id="generalRejectionFields" style="display:block;">
   <textarea name="reason" placeholder="Причина отклонения (необязательно)" rows="4" style="width:100%;padding:8px;border-radius:6px;border:1px solid #444;background:#2b2b2b;color:#fff;resize:vertical;"></textarea>
 </div>
 <button type="submit" class="btn" style="margin-top:10px;">Отклонить</button>
 </form>
 </div>
 </div>

