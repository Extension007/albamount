<% 
  /**
   * Унифицированный шаблон карточки для всех типов (товары, услуги, баннеры)
   * 
   * Параметры:
   * - product, service, banner: объект карточки (один из них должен быть передан)
   * - itemType: явно указанный тип ('product', 'service', 'banner')
   * - mode: режим отображения ('admin', 'user', 'public')
   * - user: объект текущего пользователя (для проверки владельца)
   * 
   * Использует локальную переменную 'type' вместо 'itemType', чтобы не переопределять параметр
   */
  
  // Унифицированные переменные для всех типов карточек
  const item = typeof product !== 'undefined' ? product : (typeof service !== 'undefined' ? service : banner);
  
  // Используем переданный itemType или определяем автоматически (используем type вместо itemType, чтобы не переопределять параметр)
  const type = (typeof itemType !== 'undefined')
    ? itemType
    : (typeof product !== 'undefined' ? 'product' : (typeof service !== 'undefined' ? 'service' : 'banner'));
  const itemId = (item._id || item.id).toString();
  const itemName = item.name || item.title || `Карточка ${itemId.substring(0, 8)}`;
  const itemDescription = item.description || '';
  const itemPrice = item.price != null && String(item.price).trim() !== '' ? String(item.price).trim() : '';
  const priceIsAsk = /^(уточняйте|по запросу|договорная)$/i.test(itemPrice);
  const priceIsNumeric = /^\d+(\.\d+)?$/.test(itemPrice.replace(/\s/g, ''));
  const priceLabel = priceIsAsk
    ? itemPrice
    : (priceIsNumeric ? `${itemPrice.replace(/\s/g, '')} ₸` : itemPrice);
  const itemLink = item.link || '';
  const itemVideoUrl = item.video_url || '';
  const itemCategory = item.category || '';
  const itemStatus = item.status || 'pending';
  const itemOwner = item.owner || null;
  const itemImages = item.images || [];
  const itemImageUrl = item.image_url || (itemImages.length > 0 ? itemImages[0] : null);

  // Передаем информацию о доступности Socket.IO на клиент
  // socket_io_available передается как параметр
  
  // Контакты (для товаров и услуг)
  const contacts = item.contacts || {};
  const phone = contacts.phone || '';
  const email = contacts.email || '';
  const telegram = contacts.telegram || '';
  const whatsapp = contacts.whatsapp || '';
  const contactMethod = contacts.contact_method || '';
  
  // Рейтинг (разные поля для разных типов)
  const ratingUp = item.rating_up || item.likes || 0;
  const ratingDown = item.rating_down || item.dislikes || 0;
  const ratingResult = ratingUp - ratingDown;
  const ratingTotal = ratingUp + ratingDown;
  
  // Режим отображения (admin, user, public)
  const displayMode = typeof mode !== 'undefined' ? mode : 'public';
  const isAdmin = displayMode === 'admin';
  const isUser = displayMode === 'user';
  const isPublic = displayMode === 'public';
  
  // Проверка владельца (для пользовательского режима)
  const isOwner = isUser && itemOwner && typeof user !== 'undefined' && user && (user._id || user.id) && itemOwner.toString() === (user._id || user.id).toString();
  const canEdit = isAdmin || isOwner;
  const canDelete = isAdmin || isOwner;
  
  // CSS классы для карточки
  const cardClass = displayMode === 'admin' ? 'catalog-item' : 'product-card';
  const cardDataAttr = `data-${type}-id="${itemId}"`;
%>

<!-- Передаем информацию о доступности Socket.IO на клиент -->
<script>
  window.SOCKET_IO_AVAILABLE = <%- socket_io_available ? 'true' : 'false' %>;
</script>

<div class="<%= cardClass %>" <%= cardDataAttr %>>
  <!-- Статус карточки -->
  <% if (isAdmin || isUser) { %>
    <div class="item-status-container">
      <% if (itemStatus === 'published' || itemStatus === 'approved') { %>
        <span class="item-status status-published">✅ Опубликовано</span>
      <% } else if (itemStatus === 'blocked' || itemStatus === 'rejected') { %>
        <span class="item-status status-blocked">🚫 <%= itemStatus === 'rejected' ? 'Отклонено' : 'Заблокировано' %></span>
        <% if (item.rejection_reason) { %>
          <p class="rejection-reason" style="color:#f44336;font-size:0.85rem;margin-top:5px;"><%= item.rejection_reason %></p>
        <% } %>
      <% } else if (itemStatus === 'draft') { %>
        <span class="item-status status-draft">⏳ Черновик</span>
      <% } else { %>
        <span class="item-status status-pending">⏳ На модерации</span>
      <% } %>
    </div>
  <% } %>

  <!-- Название -->
  <h3 class="item-title"><%= itemName %></h3>

  <!-- Описание (краткое) -->
  <% if (itemDescription) { %>
    <p class="item-description">
      <%= itemDescription.length > 100 ? itemDescription.substring(0, 100) + '...' : itemDescription %>
    </p>
  <% } %>

  <!-- Изображения -->
  <% if (itemImages && itemImages.length > 0) { %>
    <div class="item-images">
      <% itemImages.slice(0, 3).forEach((img, idx) => { %>
        <% if (img && img.startsWith('https://res.cloudinary.com')) { %>
          <!-- Используем безопасный URL для Cloudinary изображений -->
          <img src="<%= img %>?f_auto,q_auto,c_limit,w_800,h_600" alt="<%= itemName %>" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.png';" referrerpolicy="no-referrer">
        <% } else { %>
          <img src="<%= img %>" alt="<%= itemName %>" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.png';" referrerpolicy="no-referrer">
        <% } %>
      <% }) %>
      <% if (itemImages.length > 3) { %>
        <span class="images-count">+<%= itemImages.length - 3 %> еще</span>
      <% } %>
    </div>
  <% } else if (itemImageUrl) { %>
    <div class="item-images">
      <% if (itemImageUrl && itemImageUrl.startsWith('https://res.cloudinary.com')) { %>
        <!-- Используем безопасный URL для Cloudinary изображений -->
        <img src="<%= itemImageUrl %>?f_auto,q_auto,c_limit,w_800,h_600" alt="<%= itemName %>" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.png';" referrerpolicy="no-referrer">
      <% } else { %>
        <img src="<%= itemImageUrl %>" alt="<%= itemName %>" loading="lazy" onerror="this.onerror=null; this.src='/images/placeholder.png';" referrerpolicy="no-referrer">
      <% } %>
    </div>
  <% } else { %>
    <!-- Показываем placeholder, если изображения отсутствуют -->
    <div class="item-images">
      <img src="/images/placeholder.png" alt="Изображение отсутствует" loading="lazy" referrerpolicy="no-referrer">
    </div>
  <% } %>

  <!-- Мета-информация -->
  <div class="item-meta">
    <% if (itemLink) { %>
      <p class="meta-link">
        <span class="meta-label">Ссылка:</span>
        <a href="<%= itemLink %>" target="_blank" rel="noopener" class="item-link">
          <%= itemLink.length > 30 ? itemLink.substring(0, 30) + '...' : itemLink %>
        </a>
      </p>
    <% } %>

    <% if (itemVideoUrl) { %>
      <p class="meta-video">
        <span class="meta-label">Видео:</span>
        <button class="btn-video-link" data-video="<%= itemVideoUrl %>" type="button">
          ▶️ <%= itemVideoUrl.length > 30 ? itemVideoUrl.substring(0, 30) + '...' : itemVideoUrl %>
        </button>
      </p>
    <% } %>

    <% if (isAdmin && itemOwner) { %>
      <p class="meta-owner">
        <span class="meta-label">Владелец:</span>
        <%= itemOwner.username || itemOwner.email || 'Admin' %>
      </p>
    <% } %>

    <% if (itemCategory) { %>
      <p class="meta-category">
        <span class="meta-label">Категория:</span>
        <%= itemCategory %>
      </p>
    <% } %>

    <!-- Контакты (для товаров и услуг) -->
    <% if ((type === 'product' || type === 'service') && (phone || email || telegram || whatsapp || contactMethod)) { %>
      <div class="item-contacts">
        <% if (phone) { %>
          <p class="contact-item">
            <span class="meta-label">Телефон:</span>
            <a href="tel:<%= phone %>"><%= phone %></a>
          </p>
        <% } %>
        <% if (email) { %>
          <p class="contact-item">
            <span class="meta-label">Email:</span>
            <a href="mailto:<%= email %>"><%= email %></a>
          </p>
        <% } %>
        <% if (telegram) { %>
          <p class="contact-item">
            <span class="meta-label">Telegram:</span>
            <a href="https://t.me/<%= telegram.replace('@', '') %>" target="_blank" rel="noopener"><%= telegram %></a>
          </p>
        <% } %>
        <% if (whatsapp) { %>
          <p class="contact-item">
            <span class="meta-label">WhatsApp:</span>
            <a href="https://wa.me/<%= whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener"><%= whatsapp %></a>
          </p>
        <% } %>
        <% if (contactMethod) { %>
          <p class="contact-method">
            <span class="meta-label">Способ связи:</span>
            <span class="contact-method-text"><%= contactMethod %></span>
          </p>
        <% } %>
      </div>
    <% } %>

    <!-- Цена -->
    <% if (itemPrice) { %>
      <p class="item-price">
        <span class="meta-label">Цена:</span>
        <strong><%= priceLabel %></strong>
      </p>
    <% } %>
  </div>

  <!-- Рейтинг (голосование) -->
  <div class="item-rating <%= type %>-rating" data-id="<%= itemId %>" data-type="<%= type %>" data-voted="false">
    <button class="<%= type %>-like-btn btn-rating" type="button" aria-label="Лайк">▲</button>
    <span class="<%= type %>-result rating-result" style="font-weight: 600;"><%= ratingResult %></span>
    <button class="<%= type %>-dislike-btn btn-rating" type="button" aria-label="Дизлайк">▼</button>
    <span class="<%= type %>-votes rating-votes" style="color: #666; font-size: 0.85rem;">
      (<%= ratingTotal %> голосов)
    </span>
  </div>

  <!-- Действия -->
  <div class="item-actions">
    <% if (isAdmin) { %>
      <!-- Админские действия -->
      <% if (itemStatus === 'published' || itemStatus === 'approved') { %>
        <button class="block-<%= type %>-btn btn-block" data-id="<%= itemId %>" type="button">🚫 Заблокировать</button>
      <% } else { %>
        <button class="publish-<%= type %>-btn btn-publish" data-id="<%= itemId %>" type="button">✅ Опубликовать</button>
      <% } %>
      <button class="edit-<%= type %>-btn btn-edit btn-outline" data-id="<%= itemId %>" type="button">✏️ Редактировать</button>
      <button class="delete-<%= type %>-btn btn-delete" data-id="<%= itemId %>" type="button">🗑️ Удалить</button>
    <% } else if (isUser && isOwner) { %>
      <!-- Пользовательские действия (только для своих карточек) -->
      <button class="edit-<%= type %>-btn btn-edit btn-outline" data-id="<%= itemId %>" type="button">✏️ Редактировать</button>
      <button class="delete-<%= type %>-btn btn-delete" data-id="<%= itemId %>" type="button">🗑️ Удалить</button>
      <% if (itemLink) { %>
        <a class="btn-link btn-outline" href="<%= itemLink %>" target="_blank" rel="noopener">🔗 Ссылка</a>
      <% } %>
  <% } else if (isPublic) { %>
    <!-- Публичные действия (ссылки и чат для авторизованных пользователей) -->
    <% if (itemLink) { %>
      <a class="btn-link btn-outline" href="<%= itemLink %>" target="_blank" rel="noopener">Перейти</a>
    <% } %>
    <% if (typeof user !== 'undefined' && user) { %>
      <button class="chat-btn btn-outline" data-card-id="<%= itemId %>" type="button">💬 Чат</button>
    <% } %>
  <% } %>
  </div>

  <!-- Модальное окно чата -->
  <div class="chat-modal" id="chat-modal-<%= itemId %>" style="display: none;">
    <div class="chat-modal-overlay" onclick="closeChatModal('<%= itemId %>')"></div>
    <div class="chat-modal-content">
      <div class="chat-modal-header">
        <h3>Чат комментариев</h3>
        <button class="chat-close-btn" onclick="closeChatModal('<%= itemId %>')" type="button">×</button>
      </div>
      <div class="chat-messages" id="chat-messages-<%= itemId %>">
        <!-- Сообщения будут загружаться динамически -->
      </div>
      <div class="chat-input-container">
        <textarea
          class="chat-input"
          id="chat-input-<%= itemId %>"
          placeholder="Введите сообщение..."
          maxlength="1000"
          rows="2"
        ></textarea>
        <button class="chat-send-btn" onclick="sendChatMessage('<%= itemId %>')" type="button">Отправить</button>
      </div>
    </div>
  </div>
</div>
