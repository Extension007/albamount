<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Редактировать товар</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.0.4">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <nav class="nav">
        <ul class="nav-list">
          <li><a class="nav-link" href="/">Каталог</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn outline" href="/cabinet">← Назад в кабинет</a>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="section">
      <h2>Редактировать товар/услугу</h2>
      <form id="editProductForm" class="form-grid" enctype="multipart/form-data" method="POST" action="/cabinet/product/<%= product._id %>/edit">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" id="productId" value="<%= product._id %>">
        <!-- Селектор типа публикации -->
        <div class="form-section">
          <label for="type">Тип публикации:</label>
          <select id="type" name="type" required>
            <option value="product" <%= (product.type || 'product') === 'product' ? 'selected' : '' %>>Товар</option>
            <option value="service" <%= product.type === 'service' ? 'selected' : '' %>>Услуга</option>
          </select>
        </div>
        
        <!-- Основные поля товара -->
        <input type="text" name="name" value="<%= product.name %>" placeholder="Название товара/услуги" required>
        <textarea name="description" placeholder="Описание товара" rows="4"><%= product.description || '' %></textarea>
        <input type="number" name="price" value="<%= product.price %>" placeholder="Цена" min="0" step="1" required>
        <input type="url" name="link" value="<%= product.link || '' %>" placeholder="Ссылка на товар">
        <input type="url" name="video_url" value="<%= product.video_url || '' %>" placeholder="Ссылка на видео (YouTube, ВКонтакте, Instagram)">
        
        <!-- Поля контактов продавца -->
        <div class="form-section">
          <h3>Контакты продавца</h3>
          <input type="tel" name="phone" value="<%= (product.contacts && product.contacts.phone) || '' %>" placeholder="Телефон">
          <input type="email" name="email" value="<%= (product.contacts && product.contacts.email) || '' %>" placeholder="Email">
          <input type="text" name="telegram" value="<%= (product.contacts && product.contacts.telegram) || '' %>" placeholder="Telegram (например: @username)">
          <input type="text" name="whatsapp" value="<%= (product.contacts && product.contacts.whatsapp) || '' %>" placeholder="WhatsApp (номер телефона)">
          <textarea name="contact_method" placeholder="Способ связи (например: Звоните с 9:00 до 18:00)" rows="2"><%= (product.contacts && product.contacts.contact_method) || '' %></textarea>
        </div>

        <!-- Текущие изображения -->
        <% 
          const currentImages = product.images && Array.isArray(product.images) && product.images.length > 0 
            ? product.images 
            : (product.image_url ? [product.image_url] : []);
        %>
        <% if (currentImages.length > 0) { %>
          <div class="form-section">
            <h3>Текущие изображения:</h3>
            <div class="current-images-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:10px;margin-bottom:10px;" role="group" aria-label="Текущие изображения">
              <% currentImages.forEach((img, idx) => { %>
                <div class="current-image-item image-wrapper" data-image-index="<%= idx %>" style="position:relative;aspect-ratio:1;overflow:hidden;border-radius:8px;border:2px solid #ddd;">
                  <img src="<%= img %>" alt="Изображение <%= idx + 1 %>" data-original-url="<%= img %>" style="width:100%;height:100%;object-fit:cover;">
                  <button type="button" class="remove-image-btn image-delete-button" data-image-index="<%= idx %>" aria-label="Удалить изображение <%= idx + 1 %>" style="position:absolute;top:5px;right:5px;background:#f44336;color:#fff;border:none;border-radius:50%;width:24px;height:24px;cursor:pointer;font-size:18px;line-height:1;">×</button>
                </div>
              <% }) %>
            </div>
            <input type="hidden" name="current_images" id="currentImagesInput" value="<%= JSON.stringify(currentImages) %>">
          </div>
        <% } %>

        <!-- Загрузка новых изображений -->
        <div class="form-section">
          <label for="images">Добавить новые изображения (до 5 штук всего):</label>
          <input 
            type="file" 
            id="images" 
            name="images" 
            accept="image/png,image/jpeg,image/jpg,image/webp" 
            multiple
            data-max-files="5"
          >
          <small class="form-hint">Можно загрузить до 5 изображений всего. Форматы: PNG, JPEG, JPG, WEBP. Максимальный размер: 5MB на файл.</small>
          <div id="imagePreview" class="image-preview-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:10px;margin-top:10px;"></div>
        </div>

        <select name="category" required>
          <option value="home" <%= product.category === 'home' ? 'selected' : '' %>>Для дома</option>
          <option value="beauty" <%= product.category === 'beauty' ? 'selected' : '' %>>Красота и здоровье</option>
          <option value="auto" <%= product.category === 'auto' ? 'selected' : '' %>>Авто мото</option>
          <option value="electric" <%= product.category === 'electric' ? 'selected' : '' %>>Электрика</option>
          <option value="electronics" <%= product.category === 'electronics' ? 'selected' : '' %>>Электроника</option>
          <option value="plumbing" <%= product.category === 'plumbing' ? 'selected' : '' %>>Сантехника</option>
        </select>

        <button type="submit" class="btn primary">Сохранить изменения</button>
      </form>
      <div id="editProductMsg" class="note" style="margin-top:10px;"></div>
      <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #ddd;">
        <button type="button" id="deleteProductBtn" class="btn" style="width: 100%;">
          🗑️ Удалить карточку
        </button>
      </div>
    </section>
  </main>


  <!-- Данные от сервера для JavaScript -->
  <div id="serverData" data-product-id="<%= product._id %>" data-current-images="<%= JSON.stringify(currentImages) %>" style="display:none;"></div>

  <script src="/js/edit-form.js"></script>
  <script>
    // Получение данных от сервера
    const serverDataEl = document.getElementById('serverData');
    const productId = serverDataEl.dataset.productId;
    const currentImagesData = JSON.parse(serverDataEl.dataset.currentImages || '[]');

    // Инициализация формы редактирования после загрузки DOM
    (function() {
      function initializeForm() {
        if (typeof initEditForm === 'function') {
          initEditForm({
            mode: 'user',
            productId: productId,
            currentImages: currentImagesData
          });
        }
      }
      
      // Инициализируем сразу, если DOM уже загружен, или ждем загрузки
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeForm);
      } else {
        // DOM уже загружен
        setTimeout(initializeForm, 0);
      }
    })();
  </script>
</body>
</html>
