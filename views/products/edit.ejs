<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= mode === 'admin' ? 'Редактирование товара (Админ)' : 'Редактировать товар' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.0.1">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <nav class="nav">
        <ul class="nav-list">
          <li><a class="nav-link" href="/">Каталог</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn outline" href="<%= mode === 'admin' ? '/admin' : '/cabinet' %>">← Назад</a>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="section">
      <h2>Редактировать товар/услугу</h2>
      <form id="editProductForm" class="form-grid" enctype="multipart/form-data" method="POST" action="<%= mode === 'admin' ? (product.type === 'banner' ? `/admin/banners/${product._id}/edit` : (product.type === 'service' ? `/admin/services/${product._id}/edit` : `/admin/products/${product._id}/edit`)) : `/cabinet/product/${product._id}/edit` %>">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" id="productId" value="<%= product._id %>">
        
        <!-- Селектор типа публикации -->
        <div class="form-section">
          <label for="type">Тип публикации:</label>
          <select id="type" name="type" required aria-label="Тип публикации">
            <option value="product" <%= (product.type || 'product') === 'product' ? 'selected' : '' %>>Товар</option>
            <option value="service" <%= product.type === 'service' ? 'selected' : '' %>>Услуга</option>
          </select>
        </div>
        
        <!-- Основные поля товара -->
        <input type="text" name="name" value="<%= product.name %>" placeholder="Название товара/услуги" required aria-label="Название товара">
        <textarea name="description" placeholder="Описание товара" rows="4" aria-label="Описание товара"><%= product.description || '' %></textarea>
        <input type="text" name="price" value="<%= product.price %>" placeholder="Цена или Уточняйте" required maxlength="40" aria-label="Цена">
        <small class="form-hint">Число в тенге или текст «Уточняйте»</small>
        <input type="url" name="link" value="<%= product.link || '' %>" placeholder="Ссылка на товар" aria-label="Ссылка на товар">
        <input type="url" name="video_url" value="<%= product.video_url || '' %>" placeholder="Ссылка на видео (YouTube, ВКонтакте, Instagram)" aria-label="Ссылка на видео">
        
        <!-- Поля контактов продавца -->
        <div class="form-section">
          <h3>Контакты продавца</h3>
          <input type="tel" name="phone" value="<%= (product.contacts && product.contacts.phone) || '' %>" placeholder="Телефон" aria-label="Телефон">
          <input type="email" name="email" value="<%= (product.contacts && product.contacts.email) || '' %>" placeholder="Email" aria-label="Email">
          <input type="text" name="telegram" value="<%= (product.contacts && product.contacts.telegram) || '' %>" placeholder="Telegram (например: @username)" aria-label="Telegram">
          <input type="text" name="whatsapp" value="<%= (product.contacts && product.contacts.whatsapp) || '' %>" placeholder="WhatsApp (номер телефона)" aria-label="WhatsApp">
          <textarea name="contact_method" placeholder="Способ связи (например: Звоните с 9:00 до 18:00)" rows="2" aria-label="Способ связи"><%= (product.contacts && product.contacts.contact_method) || '' %></textarea>
        </div>

        <!-- Текущие изображения -->
        <% 
          const currentImages = product.images && Array.isArray(product.images) && product.images.length > 0 
            ? product.images 
            : (product.image_url ? [product.image_url] : []);
        %>
        <% if (currentImages.length > 0) { %>
          <div class="form-section">
            <h3>Текущие изображения:</h3>
            <div class="current-images-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:10px;margin-bottom:10px;" role="group" aria-label="Текущие изображения">
              <% currentImages.forEach((img, idx) => { %>
                <div class="current-image-item image-wrapper" data-image-index="<%= idx %>" style="position:relative;aspect-ratio:1;overflow:hidden;border-radius:8px;border:2px solid #ddd;">
                  <img src="<%= img %>" alt="Изображение <%= idx + 1 %>" data-original-url="<%= img %>" style="width:100%;height:100%;object-fit:cover;">
                  <button type="button" class="remove-image-btn image-delete-button" data-image-index="<%= idx %>" aria-label="Удалить изображение <%= idx + 1 %>" style="position:absolute;top:5px;right:5px;background:#f44336;color:#fff;border:none;border-radius:50%;width:24px;height:24px;cursor:pointer;font-size:18px;line-height:1;">×</button>
                </div>
              <% }) %>
            </div>
            <input type="hidden" name="current_images" id="currentImagesInput" value="<%= JSON.stringify(currentImages) %>">
          </div>
        <% } %>

        <!-- Загрузка новых изображений -->
        <div class="form-section">
          <label for="images">Добавить новые изображения (до 5 штук всего):</label>
          <input 
            type="file" 
            id="images" 
            name="images" 
            accept="image/png,image/jpeg,image/jpg,image/webp" 
            multiple
            data-max-files="5"
            aria-label="Выбрать изображения для загрузки"
          >
          <small class="form-hint">Можно загрузить до 5 изображений всего. Форматы: PNG, JPEG, JPG, WEBP. Максимальный размер: 5MB на файл.</small>
          <div id="imagePreview" class="image-preview-container" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(100px, 1fr));gap:10px;margin-top:10px;" role="group" aria-label="Предпросмотр новых изображений"></div>
        </div>

        <!-- Выбор категории с иерархией -->
        <div class="form-section">
          <label>Категория:</label>
          <div id="categorySelector">
            <select name="category" id="categorySelect" required aria-label="Категория товара">
              <option value="">Выберите категорию</option>
              <!-- Старые категории для обратной совместимости -->
              <option value="home" <%= (product.category === 'home' || product.category === 'home.apartments' || product.category === 'home.houses' || product.category === 'home.commercial' || product.category === 'home.land' || product.category === 'home.renovation' || product.category === 'home.smart_home' || product.category === 'home.garden' || product.category === 'home.furniture') ? 'selected' : '' %>>🏠 Недвижимость и дом</option>
              <option value="beauty" <%= (product.category === 'beauty' || product.category === 'beauty.cosmetics' || product.category === 'beauty.medical' || product.category === 'beauty.fitness_trackers' || product.category === 'beauty.biohacking' || product.category === 'beauty.nutrition' || product.category === 'beauty.services') ? 'selected' : '' %>>💄 Красота и здоровье</option>
              <option value="auto" <%= (product.category === 'auto' || product.category === 'auto.cars' || product.category === 'auto.motorcycles' || product.category === 'auto.bicycles' || product.category === 'auto.parts' || product.category === 'auto.electronics' || product.category === 'auto.service' || product.category === 'auto.carsharing' || product.category === 'auto.tuning') ? 'selected' : '' %>>🚗 Автомобили и транспорт</option>
              <option value="electronics" <%= (product.category === 'electronics' || product.category === 'electronics.phones' || product.category === 'electronics.computers' || product.category === 'electronics.appliances' || product.category === 'electronics.audio_video' || product.category === 'electronics.gaming' || product.category === 'electronics.robotics' || product.category === 'electronics.drones') ? 'selected' : '' %>>⚡ Электроника и техника</option>
              <option value="household" <%= (product.category === 'household' || product.category === 'household.textiles' || product.category === 'household.kitchen' || product.category === 'household.household_items' || product.category === 'household.lighting' || product.category === 'household.plumbing') ? 'selected' : '' %>>🛒 Для дома и быта</option>
              <option value="pets" <%= (product.category === 'pets' || product.category === 'pets.food' || product.category === 'pets.accessories' || product.category === 'pets.smart_devices' || product.category === 'pets.veterinary') ? 'selected' : '' %>>🐾 Питомцы</option>
              <option value="hobbies" <%= (product.category === 'hobbies' || product.category === 'hobbies.crafts' || product.category === 'hobbies.electronics_diy' || product.category === 'hobbies.stem' || product.category === 'hobbies.instruments' || product.category === 'hobbies.tourism') ? 'selected' : '' %>>🎨 Хобби, досуг и DIY</option>
              <option value="eco" <%= (product.category === 'eco' || product.category === 'eco.solar' || product.category === 'eco.efficient' || product.category === 'eco.materials' || product.category === 'eco.transport') ? 'selected' : '' %>>🌍 Эко‑товары и устойчивость</option>
              <option value="digital" <%= (product.category === 'digital' || product.category === 'digital.licenses' || product.category === 'digital.courses' || product.category === 'digital.microservices' || product.category === 'digital.content') ? 'selected' : '' %>>💻 Цифровые товары и услуги</option>
              <option value="additional" <%= (product.category === 'additional' || product.category === 'additional.finance' || product.category === 'additional.education' || product.category === 'additional.food_delivery' || product.category === 'additional.sports' || product.category === 'additional.ar_vr' || product.category === 'additional.remote_work') ? 'selected' : '' %>>🛍️ Дополнительные блоки</option>
              <!-- Новые категории будут добавлены через JavaScript -->
            </select>
            <div id="hierarchicalCategories" style="margin-top: 10px; display: none;">
              <!-- Иерархический выбор будет сгенерирован через JavaScript -->
            </div>
          </div>
        </div>

        <button type="submit" class="btn primary" aria-label="Сохранить изменения">Сохранить изменения</button>
      </form>
      <div id="editProductMsg" class="note" style="margin-top:10px;" role="status" aria-live="polite"></div>
    </section>
  </main>


  <!-- Данные от сервера для JavaScript -->
  <div id="serverData" data-product-id="<%= product._id %>" data-mode="<%= mode || 'user' %>" data-current-images="<%= JSON.stringify(currentImages) %>" style="display:none;"></div>

  <script src="/js/edit-form.js"></script>
  <script>
    // Получение данных от сервера
    const serverDataEl = document.getElementById('serverData');
    const productId = serverDataEl.dataset.productId;
    const mode = serverDataEl.dataset.mode;
    const currentImagesData = JSON.parse(serverDataEl.dataset.currentImages || '[]');

    // Инициализация формы редактирования после загрузки DOM
    (function() {
      function initializeForm() {
        if (typeof initEditForm === 'function') {
          initEditForm({
            mode: mode,
            productId: productId,
            currentImages: currentImagesData
          });
        }
      }
      
      // Инициализируем сразу, если DOM уже загружен, или ждем загрузки
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeForm);
      } else {
        // DOM уже загружен
        setTimeout(initializeForm, 0);
      }
    })();
    
    // Иерархическая структура категорий
    const hierarchicalCategories = {
      "home": {
        label: "🏠 Недвижимость и дом",
        children: {
          "apartments": {
            label: "Квартиры",
            children: {
              "sale": { label: "Продажа" },
              "rent": { label: "Аренда" },
              "new_buildings": { label: "Новостройки" }
            }
          },
          "houses": { label: "Дома и коттеджи" },
          "commercial": { label: "Коммерческая недвижимость" },
          "land": { label: "Земельные участки" },
          "renovation": { label: "Ремонт и дизайн интерьера" },
          "smart_home": { label: "Умный дом и автоматизация" },
          "garden": { label: "Сад и огород" },
          "furniture": { label: "Мебель и интерьер" }
        }
      },
      "auto": {
        label: "🚗 Автомобили и транспорт",
        children: {
          "cars": {
            label: "Автомобили",
            children: {
              "new": { label: "Новые" },
              "used": { label: "Б/у" },
              "electric": { label: "Электромобили и зарядные станции" }
            }
          },
          "motorcycles": { label: "Мотоциклы и скутеры" },
          "bicycles": { label: "Велосипеды и электросамокаты" },
          "parts": { label: "Запчасти и аксессуары" },
          "electronics": {
            label: "Автоэлектроника",
            children: {
              "navigators": { label: "Навигаторы" },
              "recorders": { label: "Видеорегистраторы" },
              "multimedia": { label: "Мультимедиа" }
            }
          },
          "service": { label: "Сервис и ремонт" },
          "carsharing": { label: "Аренда и каршеринг" },
          "tuning": { label: "Тюнинг и кастомизация" }
        }
      },
      "electronics": {
        label: "⚡ Электроника и техника",
        children: {
          "phones": { label: "Смартфоны и аксессуары" },
          "computers": { label: "Компьютеры и периферия" },
          "appliances": {
            label: "Бытовая техника",
            children: {
              "large": { label: "Крупная" },
              "small": { label: "Мелкая" }
            }
          },
          "audio_video": { label: "Аудио и видео техника" },
          "gaming": {
            label: "Игровая электроника",
            children: {
              "consoles": { label: "Консоли" },
              "vr_ar": { label: "VR/AR устройства" },
              "gaming_peripherals": { label: "Геймерская периферия" }
            }
          },
          "robotics": { label: "Робототехника и автоматизация быта" },
          "drones": { label: "Дроны и квадрокоптеры" }
        }
      },
      "beauty": {
        label: "💄 Красота и здоровье",
        children: {
          "cosmetics": { label: "Косметика и уход" },
