        }
      },
      "eco": {
        label: "🌍 Эко‑товары и устойчивость",
        children: {
          "solar": { label: "Солнечные панели и альтернативная энергия" },
          "efficient": { label: "Энергоэффективные устройства" },
          "materials": { label: "Перерабатываемые и биоразлагаемые материалы" },
          "transport": { label: "Электротранспорт" }
        }
      },
      "digital": {
        label: "💻 Цифровые товары и услуги",
        children: {
          "licenses": { label: "Лицензии и подписки" },
          "courses": { label: "Онлайн‑курсы и обучение" },
          "microservices": { label: "Микро‑услуги и фриланс" },
          "content": { label: "Цифровой контент (шаблоны, медиа, NFT)" }
        }
      },
      "additional": {
        label: "🛍️ Дополнительные блоки",
        children: {
          "finance": { label: "Финансы и инвестиции" },
          "education": { label: "Образование и карьера" },
          "food_delivery": { label: "Продукты питания и доставка" },
          "sports": { label: "Спорт и активный образ жизни" },
          "ar_vr": { label: "AR/VR‑категории" },
          "remote_work": { label: "Удалённая работа и офис" }
        }
      }
    };

    // Функция для генерации иерархического выбора категорий
    function buildHierarchicalSelector(parentElement, categories, prefix = '', level = 0, currentValue = '') {
      parentElement.innerHTML = '';
      
      const container = document.createElement('div');
      container.style.marginLeft = level * 20 + 'px';
      container.style.marginTop = '10px';
      
      const select = document.createElement('select');
      select.className = 'category-select';
      select.setAttribute('data-level', level);
      select.innerHTML = '<option value="">Выберите ' + (level === 0 ? 'основную категорию' : 'подкатегорию') + '</option>';
      
      for (const [key, value] of Object.entries(categories)) {
        const option = document.createElement('option');
        const fullKey = prefix ? `${prefix}.${key}` : key;
        option.value = fullKey;
        option.textContent = value.label;
        
        // Если это текущее значение категории или его часть, делаем его выбранным
        if (currentValue === fullKey || currentValue.startsWith(fullKey + '.')) {
          option.selected = true;
        }
        
        select.appendChild(option);
      }
      
      container.appendChild(select);
      parentElement.appendChild(container);
      
      select.addEventListener('change', function() {
        const selectedValue = this.value;
        if (selectedValue) {
          // Обновляем скрытое поле категории
          document.querySelector('input[name="category"], select[name="category"]').value = selectedValue;
          
          // Удаляем все дочерние селекторы
          const childSelectors = parentElement.querySelectorAll(`.category-select[data-level]:not([data-level="${level}"])`);
          childSelectors.forEach(child => {
            if (parseInt(child.getAttribute('data-level')) > level) {
              child.closest('div').remove();
            }
          });
          
          // Если у выбранной категории есть подкатегории, создаем новый селектор
          const categoryPath = selectedValue.split('.');
          let currentCategory = hierarchicalCategories;
          
          for (const path of categoryPath) {
            if (currentCategory && currentCategory[path]) {
              currentCategory = currentCategory[path].children;
            } else {
              currentCategory = null;
              break;
            }
          }
          
          if (currentCategory) {
            buildHierarchicalSelector(parentElement, currentCategory, level + 1, selectedValue, currentValue);
          }
        }
      });
      
      // Если у нас есть текущее значение и это не самый глубокий уровень, продолжаем строить иерархию
      if (currentValue) {
        const currentValueParts = currentValue.split('.');
        if (currentValueParts.length > level + 1) {
          const nextLevelKey = currentValueParts[level + 1];
          const currentCategoryPath = currentValueParts.slice(0, level + 1).join('.');
          
          let currentCategory = hierarchicalCategories;
          for (const path of currentValueParts.slice(0, level + 1)) {
            if (currentCategory && currentCategory[path]) {
              currentCategory = currentCategory[path].children;
            } else {
              currentCategory = null;
              break;
            }
          }
          
          if (currentCategory && currentCategory[nextLevelKey]) {
            buildHierarchicalSelector(parentElement, currentCategory[nextLevelKey].children, level + 1, currentValueParts.slice(0, level + 1).join('.'), '<%= product.category %>');
          }
        }
      }
    }

    // Инициализация иерархического выбора категорий
    document.addEventListener('DOMContentLoaded', function() {
      const categorySelector = document.getElementById('categorySelector');
      const hierarchicalDiv = document.getElementById('hierarchicalCategories');
      const categorySelect = document.getElementById('categorySelect');
      
      // Функция для обновления отображения иерархического выбора
      function updateHierarchicalDisplay() {
        const currentCategory = '<%= product.category %>';
        const hasHierarchicalPrefix = currentCategory.includes('.');
        
        // Проверяем, является ли выбранная категория частью иерархической структуры
        const isHierarchicalCategory = Object.keys(hierarchicalCategories).some(key =>
          currentCategory === key || currentCategory.startsWith(key + '.')
        );
        
        if (categorySelect.value === '' || isHierarchicalCategory) {
          hierarchicalDiv.style.display = 'block';
          buildHierarchicalSelector(hierarchicalDiv, hierarchicalCategories, 0, '', currentCategory);
        } else {
          hierarchicalDiv.style.display = 'none';
        }
      }
      
      categorySelect.addEventListener('change', function() {
        const selectedValue = this.value;
        if (selectedValue) {
          // Если выбрана конкретная категория, скрываем иерархический выбор
          hierarchicalDiv.style.display = 'none';
        } else {
          // Если выбрана пустая опция, показываем иерархический выбор
          hierarchicalDiv.style.display = 'block';
          buildHierarchicalSelector(hierarchicalDiv, hierarchicalCategories, 0, '', '<%= product.category %>');
        }
      });
      
      // Инициализируем отображение
      updateHierarchicalDisplay();
    });
  </script>
</body>
</html>
