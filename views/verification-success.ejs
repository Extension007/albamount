<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email подтвержден - Albamount</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <div class="header-actions">
        <a class="btn outline" href="/">На главную</a>
      </div>
    </div>
  </header>

  <main>
    <div class="container verification-page">
      <h1 class="page-title"><%= typeof alreadyVerified !== 'undefined' && alreadyVerified ? 'Email уже подтверждён' : '✅ Email подтвержден!' %></h1>
      <p class="message">
        <%= typeof message !== 'undefined' && message
          ? message
          : ('Поздравляем, ' + (typeof username !== 'undefined' ? username : 'пользователь') + '! Ваш email успешно подтвержден. Теперь вы можете использовать все возможности нашего сервиса.') %>
      </p>
      <% if (typeof email !== 'undefined' && email) { %>
        <p class="message" style="opacity:0.85;">Адрес: <strong><%= email %></strong></p>
      <% } %>

      <div class="actions">
        <a href="/user/login" class="btn primary">Войти в аккаунт</a>
        <a href="/cabinet" class="btn outline">В кабинет</a>
        <a href="/" class="btn outline">На главную</a>
      </div>
    </div>
  </main>

  <%- include('partials/mobile-tabs') %>
</body>
</html>
