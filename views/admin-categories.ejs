<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Управление категориями</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=1.0.4">
  <style>
    .category-tree {
      margin: 20px 0;
    }
    .category-item {
      margin: 10px 0;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 8px;
      background: #f9f9f9;
    }
    .category-item.level-1 { margin-left: 20px; }
    .category-item.level-2 { margin-left: 40px; }
    .category-item.level-3 { margin-left: 60px; }
    .category-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .category-actions {
      display: flex;
      gap: 10px;
    }
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.4);
    }
    .modal-content {
      background-color: #fefefe;
      margin: 15% auto;
      padding: 20px;
      border: 1px solid #888;
      width: 90%;
      max-width: 500px;
      border-radius: 8px;
    }
    .form-group {
      margin-bottom: 15px;
    }
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: 600;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    .btn-group {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div id="bg-animated" aria-hidden="true"></div>
  <header class="main-header">
    <div class="container header-inner">
      <a class="logo" href="/"><img src="/albamount.png" alt="ALBAMOUNT" class="logo-img"></a>
      <nav class="nav">
        <ul class="nav-list">
          <li><a class="nav-link" href="/admin">Главная</a></li>
          <li><a class="nav-link active" href="/admin/categories">Категории</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <a class="btn outline" href="/admin">← Назад</a>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="section">
      <div class="section-header">
        <h2>Управление категориями</h2>
        <button class="btn primary" onclick="openCreateModal()">+ Добавить категорию</button>
      </div>

      <div class="tabs">
        <button class="tab active" data-type="product">Товары</button>
        <button class="tab" data-type="service">Услуги</button>
        <button class="tab" data-type="banner">Баннеры</button>
        <button class="tab" data-type="all">Все</button>
      </div>

      <div class="tab-content active" id="categories-product">
        <h3>Категории товаров</h3>
        <div id="tree-product" class="category-tree">
          <!-- Категории товаров будут загружены через JavaScript -->
        </div>
      </div>

      <div class="tab-content" id="categories-service">
        <h3>Категории услуг</h3>
        <div id="tree-service" class="category-tree">
          <!-- Категории услуг будут загружены через JavaScript -->
        </div>
      </div>

      <div class="tab-content" id="categories-banner">
        <h3>Категории баннеров</h3>
        <div id="tree-banner" class="category-tree">
          <!-- Категории баннеров будут загружены через JavaScript -->
        </div>
      </div>

      <div class="tab-content" id="categories-all">
        <h3>Все категории</h3>
        <div id="tree-all" class="category-tree">
          <!-- Все категории будут загружены через JavaScript -->
        </div>
      </div>
    </section>
  </main>

  <!-- Модальное окно создания/редактирования категории -->
  <div id="categoryModal" class="modal">
    <div class="modal-content">
      <h3 id="modalTitle">Создать категорию</h3>
      <form id="categoryForm">
        <input type="hidden" id="categoryId" name="categoryId">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="categoryName">Название:</label>
          <input type="text" id="categoryName" name="name" required>
        </div>

        <div class="form-group">
          <label for="categoryType">Тип:</label>
          <select id="categoryType" name="type" required>
            <option value="product">Товары</option>
            <option value="service">Услуги</option>
            <option value="banner">Баннеры</option>
            <option value="all">Все</option>
          </select>
        </div>

        <div class="form-group">
          <label for="categoryParent">Родительская категория:</label>
          <select id="categoryParent" name="parentId">
            <option value="">Нет родителя</option>
            <!-- Опции будут загружены динамически -->
          </select>
        </div>

        <div class="form-group">
          <label for="categoryIcon">Иконка (emoji):</label>
          <input type="text" id="categoryIcon" name="icon" placeholder="🏠">
        </div>

        <div class="form-group">
          <label for="categoryDescription">Описание:</label>
          <textarea id="categoryDescription" name="description" rows="3"></textarea>
        </div>

        <div class="form-group">
          <label for="categoryOrder">Порядок сортировки:</label>
          <input type="number" id="categoryOrder" name="order" value="0">
        </div>

        <div class="btn-group">
          <button type="button" class="btn outline" onclick="closeModal()">Отмена</button>
          <button type="submit" class="btn primary">Сохранить</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let currentType = 'product';
    let categoriesData = {};

    function getCsrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    }

    async function csrfFetch(url, options = {}) {
      const headers = Object.assign({}, options.headers || {});
      const method = (options.method || 'GET').toUpperCase();
      if (method !== 'GET' && method !== 'HEAD') {
        headers['X-CSRF-Token'] = getCsrfToken();
      }
      return fetch(url, Object.assign({}, options, { headers, credentials: 'same-origin' }));
    }

    // Переключение вкладок
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const type = tab.dataset.type;
          switchTab(type);
        });
      });

      // Загружаем категории для активной вкладки
      loadCategories(currentType);

      // Обработчик формы
      document.getElementById('categoryForm').addEventListener('submit', handleFormSubmit);
    });

    function switchTab(type) {
      currentType = type;

      // Переключаем активные вкладки
      document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('active');
        if (tab.dataset.type === type) {
          tab.classList.add('active');
        }
      });

      // Переключаем контент
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.remove('active');
        if (content.id === `categories-${type}`) {
          content.classList.add('active');
        }
      });

      // Загружаем категории для выбранного типа
      loadCategories(type);
    }

    async function loadCategories(type) {
      try {
        const response = await fetch(`/api/categories/tree/${type}`);
        const data = await response.json();

        if (data.success) {
          categoriesData[type] = data.categories;
          renderCategoryTree(type, data.categories);
        } else {
        }
      } catch (error) {
      }
    }

    function renderCategoryTree(type, categories) {
      const container = document.getElementById(`tree-${type}`);
      container.textContent = '';

      function renderItems(items, level = 0) {
        items.forEach(category => {
          const item = document.createElement('div');
          item.className = `category-item level-${level}`;
          item.style.marginLeft = `${level * 20}px`;

          const header = document.createElement('div');
          header.className = 'category-header';

          const info = document.createElement('div');
          const title = document.createElement('strong');
          title.textContent = `${category.icon || ''} ${category.name || ''}`.trim();
          info.appendChild(title);

          const levelLabel = document.createElement('span');
          levelLabel.className = 'category-level-indicator';
          levelLabel.textContent = level === 0 ? 'Блок' : level === 1 ? 'Категория' : 'Подкатегория';
          info.appendChild(document.createTextNode(' '));
          info.appendChild(levelLabel);

          if (category.description) {
            info.appendChild(document.createElement('br'));
            const small = document.createElement('small');
            small.textContent = category.description;
            info.appendChild(small);
          }

          const actions = document.createElement('div');
          actions.className = 'category-actions';

          const editBtn = document.createElement('button');
          editBtn.className = 'btn small outline';
          editBtn.type = 'button';
          editBtn.textContent = '✏️';
          editBtn.addEventListener('click', () => editCategory(String(category._id || category.id)));

          const addBtn = document.createElement('button');
          addBtn.className = 'btn small outline';
          addBtn.type = 'button';
          addBtn.textContent = '+';
          addBtn.addEventListener('click', () => addSubcategory(String(category._id || category.id)));

          const delBtn = document.createElement('button');
          delBtn.className = 'btn small danger';
          delBtn.type = 'button';
          delBtn.textContent = '🗑️';
          delBtn.addEventListener('click', () => deleteCategory(String(category._id || category.id), category.name || ''));

          actions.appendChild(editBtn);
          actions.appendChild(addBtn);
          actions.appendChild(delBtn);
          header.appendChild(info);
          header.appendChild(actions);
          item.appendChild(header);
          container.appendChild(item);

          if (category.children && category.children.length > 0) {
            renderItems(category.children, level + 1);
          }
        });
      }

      if (!categories || categories.length === 0) {
        const empty = document.createElement('p');
        empty.textContent = 'Категории не найдены. Создайте первую категорию.';
        container.appendChild(empty);
      } else {
        renderItems(categories);
      }
    }

    function openCreateModal() {
      document.getElementById('modalTitle').textContent = 'Создать категорию';
      document.getElementById('categoryId').value = '';
      document.getElementById('categoryForm').reset();
      document.getElementById('categoryType').value = currentType === 'all' ? 'product' : currentType;
      loadParentOptions();
      document.getElementById('categoryModal').style.display = 'block';
    }

    function editCategory(id) {
      // Найти категорию по ID
      function findCategory(items) {
        for (const item of items) {
          if (item._id === id) return item;
          if (item.children) {
            const found = findCategory(item.children);
            if (found) return found;
          }
        }
        return null;
      }

      const category = findCategory(categoriesData[currentType]);
      if (!category) return;

      document.getElementById('modalTitle').textContent = 'Редактировать категорию';
      document.getElementById('categoryId').value = category._id;
      document.getElementById('categoryName').value = category.name;
      document.getElementById('categoryType').value = category.type;
      document.getElementById('categoryIcon').value = category.icon || '';
      document.getElementById('categoryDescription').value = category.description || '';
      document.getElementById('categoryOrder').value = category.order || 0;

      loadParentOptions(category.parentId);
      document.getElementById('categoryModal').style.display = 'block';
    }

    function addSubcategory(parentId) {
      document.getElementById('modalTitle').textContent = 'Создать подкатегорию';
      document.getElementById('categoryId').value = '';
      document.getElementById('categoryForm').reset();
      document.getElementById('categoryType').value = currentType === 'all' ? 'product' : currentType;
      document.getElementById('categoryParent').value = parentId;
      loadParentOptions(parentId);
      document.getElementById('categoryModal').style.display = 'block';
    }

    function loadParentOptions(selectedParentId = '') {
      const parentSelect = document.getElementById('categoryParent');
      parentSelect.innerHTML = '<option value="">Нет родителя</option>';

      function addOptions(items, prefix = '') {
        items.forEach(item => {
          const option = document.createElement('option');
          option.value = item._id;
          option.textContent = prefix + (item.icon || '') + ' ' + item.name;
          if (item._id === selectedParentId) {
            option.selected = true;
          }
          parentSelect.appendChild(option);

          if (item.children && item.children.length > 0) {
            addOptions(item.children, prefix + '— ');
          }
        });
      }

      if (categoriesData[currentType]) {
        addOptions(categoriesData[currentType]);
      }
    }

    function closeModal() {
      document.getElementById('categoryModal').style.display = 'none';
    }

    async function handleFormSubmit(e) {
      e.preventDefault();

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());
      const categoryId = data.categoryId;

      try {
        const url = categoryId ? `/api/categories/${categoryId}` : '/api/categories';
        const method = categoryId ? 'PUT' : 'POST';

        const response = await csrfFetch(url, {
          method: method,
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
          closeModal();
          loadCategories(currentType);
          alert(result.message || 'Категория сохранена');
        } else {
          alert('Ошибка: ' + result.message);
        }
      } catch (error) {
        alert('Ошибка сети');
      }
    }

    async function deleteCategory(id, name) {
      if (!confirm(`Вы уверены, что хотите удалить категорию "${name}"?`)) {
        return;
      }

      try {
        const response = await csrfFetch(`/api/categories/${id}`, {
          method: 'DELETE'
        });

        const result = await response.json();

        if (result.success) {
          loadCategories(currentType);
          alert('Категория удалена');
        } else {
          alert('Ошибка: ' + result.message);
        }
      } catch (error) {
        alert('Ошибка сети');
      }
    }

    // Закрытие модального окна по клику вне его
    window.onclick = function(event) {
      const modal = document.getElementById('categoryModal');
      if (event.target === modal) {
        closeModal();
      }
    }
  </script>
</body>
</html>
